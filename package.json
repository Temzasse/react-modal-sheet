{
  "name": "react-modal-sheet",
  "version": "5.7.0",
  "description": "Flexible bottom sheet component for your React apps",
  "keywords": [
    "accessibility",
    "bottom-sheet",
    "framer-motion",
    "modal",
    "motion",
    "react"
  ],
  "homepage": "https://temzasse.github.io/react-modal-sheet",
  "license": "MIT",
  "author": "Teemu Taskula",
  "repository": "https://github.com/Temzasse/react-modal-sheet",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build:verify": "attw --pack .",
    "build": "tsdown",
    "dev": "npm run docs:dev --",
    "docs:build": "npm --prefix docs run build",
    "docs:check": "npm --prefix docs run check",
    "docs:deploy": "npm --prefix docs run deploy",
    "docs:dev": "npm --prefix docs run dev --",
    "docs:preview": "npm --prefix docs run preview --",
    "format:check": "oxfmt --check ./src ./test ./docs vitest.config.mts",
    "format:write": "oxfmt --write ./src ./test ./docs vitest.config.mts",
    "lint:check": "oxlint --deny-warnings ./src ./test ./docs vitest.config.mts",
    "lint:write": "oxlint --deny-warnings --fix ./src ./test ./docs vitest.config.mts",
    "prepare": "husky",
    "release": "npm run verify && npm run build && npm run build:verify && np",
    "test:browser": "vitest run --project browser",
    "test:ssr": "vitest run --project unit test/ssr.test.tsx",
    "test:unit": "vitest run --project unit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "run-p format:check lint:check typecheck"
  },
  "dependencies": {
    "react-use-measure": "2.1.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@astrojs/compiler-rs": "0.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/browser-playwright": "5.1.0",
    "husky": "9.1.7",
    "motion": "14.10.1",
    "npm-run-all": "4.1.5",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "playwright": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vitest-browser-react": "2.3.0"
  },
  "peerDependencies": {
    "motion": ">=11",
    "react": ">=16"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
