---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<link
  rel="icon"
  type="image/svg+xml"
  href={`${base}/favicon.svg`}
  media="(prefers-color-scheme: light)"
/>
<link
  rel="icon"
  type="image/svg+xml"
  href={`${base}/favicon-dark.svg`}
  media="(prefers-color-scheme: dark)"
/>
